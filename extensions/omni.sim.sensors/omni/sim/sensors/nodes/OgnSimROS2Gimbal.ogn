{
  "ROS2Gimbal": {
    "version": 1,
    "description": "Subscribe to ROS2 topic and read gimbal angles, and update the cameras offsets live",
    "language": "Python",
    "metadata": {
      "uiName": "ROS2 Gimbal"
    },
    "inputs": {
      "execIn": {
        "type": "execution",
        "description": "Execution trigger to read ROS2 messages",
        "default": 0,
        "metadata": {
          "uiName": "Exec In"
        }
      },
      "gimbal_topic": {
        "type": "string",
        "description": "ROS 2 topic for Gimbal(roll, pitch, yaw)",
        "default": "/isaac_core/gimbal",
        "metadata": {
          "uiName": "Gimbal Topic"
        }
      },
      "start_roll": {
        "type": "float",
        "description": "Initial roll offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Roll"
        }
      },
      "start_pitch": {
        "type": "float",
        "description": "Initial pitch offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Pitch"
        }
      },
      "start_yaw": {
        "type": "float",
        "description": "Initial yaw offset in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "Start Yaw"
        }
      }
    },
    "outputs": {
      "roll": {
        "type": "float",
        "description": "roll in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "roll"
        }
      },
      "pitch": {
        "type": "float",
        "description": "pitch in degrees",
        "default": 0.0,
        "metadata": {
          "uiName": "pitch"
        }
      },
      "yaw": {
      "type": "float",
      "description": "yaw in degrees",
      "default": 0.0,
      "metadata": {
          "uiName": "yaw"
        }
      }
    }
  }
}
