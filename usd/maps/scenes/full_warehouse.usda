def Xform "World"
{
    def "full_warehouse_carter_v2_3_gxf" (
        prepend payload = @http://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/2023.1.1/Isaac/Samples/Isaac_AMR/2.0/Scenarios/full_warehouse_carter_v2_3_gxf.usd@
    )
    {
        over "Robots" (
            active = false
        )
        {
            over "carter_v2_3_gxf"
            {
                over "ActionGraph"
                {
                    int2 fileFormatVersion = (1, 7)

                    over "isaac_read_imu_node"
                    {
                        custom bool inputs:readGravity
                        custom bool inputs:useLatestData
                        custom float outputs:sensorTime
                    }

                    over "isaac_create_render_product_hawk_left"
                    {
                        custom bool inputs:enabled
                    }

                    over "isaac_create_render_product_hawk_right"
                    {
                        custom bool inputs:enabled
                    }

                    over "make_array"
                    {
                        custom token inputs:input0
                        delete token inputs:input0.connect = </World/full_warehouse_carter_v2_3_gxf/Robots/carter_v2_3_gxf/ActionGraph/constant_token.inputs:value>
                        prepend token inputs:input0.connect = </World/full_warehouse_carter_v2_3_gxf/Robots/carter_v2_3_gxf/ActionGraph/constant_token.inputs:value>
                        custom token inputs:input1
                        delete token inputs:input1.connect = </World/full_warehouse_carter_v2_3_gxf/Robots/carter_v2_3_gxf/ActionGraph/constant_token_01.inputs:value>
                        prepend token inputs:input1.connect = </World/full_warehouse_carter_v2_3_gxf/Robots/carter_v2_3_gxf/ActionGraph/constant_token_01.inputs:value>
                    }

                    over "make_array_03"
                    {
                        custom token inputs:input0 (
                            customData = {
                                dictionary omni = {
                                    dictionary graph = {
                                        string resolvedType = "token"
                                    }
                                }
                            }
                        )
                    }

                    over "make_depth"
                    {
                        custom token inputs:input0 (
                            customData = {
                                dictionary omni = {
                                    dictionary graph = {
                                        string resolvedType = "uint64"
                                    }
                                }
                            }
                        )
                    }

                    over "make_array_01"
                    {
                        custom token inputs:input0 (
                            customData = {
                                dictionary omni = {
                                    dictionary graph = {
                                        string resolvedType = "token"
                                    }
                                }
                            }
                        )
                    }
                }
            }
        }

        over "Environment"
        {
            over "full_warehouse"
            {
                over "RectLight"
                {
                    float inputs:colorTemperature = 6500
                }

                over "RectLight_01"
                {
                    float inputs:intensity = 200
                }

                over "RectLight_03"
                {
                    float inputs:colorTemperature = 6500
                }

                over "RectLight_04"
                {
                    float inputs:intensity = 2000
                }
            }
        }
    }
}

def Xform "Environment"
{
    quatd xformOp:orient = (1, 0, 0, 0)
    double3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def DistantLight "defaultLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:angle = 1
        float inputs:intensity = 3000
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        quatd xformOp:orient = (0.6532814824381883, 0.2705980500730985, 0.27059805007309845, 0.6532814824381882)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

def CesiumDataPrim "Cesium"
{
    prepend rel cesium:selectedIonServer = </CesiumServers/IonOfficial>
}

def CesiumGeoreferencePrim "CesiumGeoreference"
{
    matrix4d cesium:ecefToUsdTransform = ( (0.9647534819407177, 0.1682239812131189, -0.20236455032458023, 0), (-0.2631553136139595, 0.6167258011721835, -0.741888513919219, 0), (2.7755575615628914e-17, 0.7689928337204038, 0.6392573986170699, 0), (-1.1260326425004901e-10, 21025.701877878048, -6371656.822771804, 1) )
}

def "CesiumServers"
{
    def CesiumIonServerPrim "IonOfficial"
    {
        string cesium:displayName = "ion.cesium.com"
        string cesium:ionServerApiUrl = "https://api.cesium.com/"
        int64 cesium:ionServerApplicationId = 413
        string cesium:ionServerUrl = "https://ion.cesium.com/"
    }
}

def CesiumTilesetPrim "Cesium_Tileset"
{
    prepend rel cesium:georeferenceBinding = </CesiumGeoreference>
    string cesium:ionAccessToken = ""
    int64 cesium:ionAssetId = 0
    prepend rel cesium:ionServerBinding = </CesiumServers/IonOfficial>
    uniform token cesium:sourceType = "ion"
}

