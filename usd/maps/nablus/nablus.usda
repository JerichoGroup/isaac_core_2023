def Xform "Environment"
{
    def DomeLight "DomeLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:intensity = 1000
        float inputs:shaping:cone:angle = 180
        float inputs:shaping:cone:softness
        float inputs:shaping:focus
        color3f inputs:shaping:focusTint
        asset inputs:shaping:ies:file
        asset inputs:texture:file = @../../assets/sunflowers_puresky_4k.exr@
        token inputs:texture:format = "latlong"
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }
}

def CesiumDataPrim "Cesium"
{
    rel cesium:selectedIonServer = </CesiumServers/IonOfficial>
}

def CesiumGeoreferencePrim "CesiumGeoreference"
{
    matrix4d cesium:ecefToUsdTransform = ( (-0.5772336982984184, -0.4354349110063949, 0.6907949737987268, 0), (0.816578996514563, -0.3078057421526901, 0.4883178959951203, 0), (0, 0.8459622115524339, 0.5332428495772966, 0), (4.656612873077393e-10, 19280.982657559216, -6372580.310832208, 1) )
    double cesium:georeferenceOrigin:height = 516.7
    double cesium:georeferenceOrigin:latitude = 32.22481
    double cesium:georeferenceOrigin:longitude = 35.25621
}

def CesiumTilesetPrim "Cesium_Tileset"
{
    prepend rel cesium:georeferenceBinding = </CesiumGeoreference>
    string cesium:ionAccessToken = ""
    int64 cesium:ionAssetId = 0
    rel cesium:ionServerBinding = None
    uniform token cesium:sourceType = "url"
    string cesium:url = "http://10.44.134.2:8000/nablus/tileset.json"
    float3[] extent = [(-7982.7725, -5877.865, -751.89636), (8347.764, 3756.5452, 699.53015)]
    token visibility = "inherited"
}

def "CesiumServers"
{
    def CesiumIonServerPrim "IonOfficial"
    {
        string cesium:displayName = "ion.cesium.com"
        string cesium:ionServerApiUrl = "https://api.cesium.com/"
        int64 cesium:ionServerApplicationId = 413
        string cesium:ionServerUrl = "https://ion.cesium.com/"
    }
}

